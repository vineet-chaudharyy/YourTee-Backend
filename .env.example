PORT=5001

# SQLite database file. Relative paths resolve against the backend root.
# The file and its parent directory are created automatically on first run.
SQLITE_PATH=data/yourtee.db

# Must match JWT_SECRET in the frontend's .env.local — this API signs the
# yt_token cookie and the frontend only verifies it.
JWT_SECRET=your_jwt_signing_secret_here

NODE_ENV=development

# Public origin of the storefront, used to build links inside emails
# (password reset, order tracking). No trailing slash.
APP_URL=http://localhost:3007

# Razorpay API Credentials (set these to enable real payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP (verification, password reset and order confirmation emails).
# Leave blank in development and the links are logged to the terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=YourTee <no-reply@yourtee.in>
